rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /menu/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /themes/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
