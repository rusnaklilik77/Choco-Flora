# Скопируйте этот файл в .env (для локальной разработки)
# и/или впишите те же значения в Vercel -> Project Settings -> Environment Variables.
#
# Взять значения: https://console.firebase.google.com
# -> шестерёнка (Project settings) -> вкладка General -> раздел "Your apps"
# -> веб-приложение (</>) -> "SDK setup and configuration" -> Config
#
# Нужен только бесплатный тариф Spark и включённый Firestore Database.
# Firebase Storage НЕ используется и НЕ нужен (он платный) — сами фото
# лежат у вас на Google Диске (или любом другом хостинге), а в Firestore
# хранится только ссылка на них, цена и описание — это занимает очень
# мало места, так что бесплатного плана хватит с большим запасом.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
